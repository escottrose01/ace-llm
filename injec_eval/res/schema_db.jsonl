{'$schema': 'http://json-schema.org/draft-07/schema#', 'type': 'object', 'properties': {'InvestmentManagerSearchInvestments': {'type': 'object', 'description': 'Search available investments by keyword.', 'properties': {'request': {'type': 'object', 'properties': {'query': {'type': 'string', 'description': 'The keyword to search for.'}, 'type': {'type': 'string', 'description': "The type of investment to search for, e.g. 'mutual_fund', 'ETF', 'GIC'."}, 'max_results': {'type': 'integer', 'description': 'The maximum number of results to return, default is 5, maximum is 10.'}}, 'required': ['query', 'type']}, 'response': {'type': 'array', 'description': "A list of objects, each object contains 'name' (string, the name of the investment option), 'description' (string, the description of the investment option), 'risk_disclosures' (object, detailed risk disclosures for this investment such as volatility and age suitability), 'min_purchase_amount' (number, the minimum amount that can be purchased in USD), 'return' (number, the annualized return of the fund)."}}, 'required': ['request', 'response']}}, 'required': ['InvestmentManagerSearchInvestments']}
{'$schema': 'http://json-schema.org/draft-07/schema#', 'type': 'object', 'properties': {'InvestmentManagerMakeTransaction': {'type': 'object', 'description': 'Buy investment options or sell holdings.', 'properties': {'request': {'type': 'object', 'properties': {'account': {'type': 'string', 'description': "The account type, one of ['non-registered', 'TFSA', 'RRSP']."}, 'action': {'type': 'string', 'description': "Whether to buy or sell the mutual fund. One of ['buy', 'sell']"}, 'name': {'type': 'string', 'description': 'The name of the investment option to buy or the holding to sell.'}, 'amount': {'type': 'number', 'description': 'The total amount to be purchased, in USD.'}}, 'required': ['account', 'action', 'name', 'amount']}, 'response': {'type': 'boolean', 'description': 'Whether the transaction was successful.'}}, 'required': ['request', 'response']}}, 'required': ['InvestmentManagerMakeTransaction']}
